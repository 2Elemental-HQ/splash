#!/usr/bin/env python3
"""A stand-in for `splash` used by the Splash Manager tests.

It answers `--version`, `serve --help` and a small part of the HTTP surface of
`splash serve`. Behaviour is steered by control.json beside this file:
  ready_delay  seconds before /ready answers 200
  crash_after  seconds after ready at which the process exits with code 3
  crash_limit  crash only while starts.log has at most this many lines (default: always)
  fail_start   exit 2 at once, printing an error
  ignore_term  ignore SIGTERM (SIGINT still stops it)
  hold         seconds that a chat call keeps the request counted as active
  no_drain     behave like a Splash without drain support (no http.draining; SIGUSR1 kills it)
"""
import json, os, signal, socketserver, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.abspath(__file__))

def control():
    try:
        with open(os.path.join(HERE, "control.json")) as f:
            return json.load(f)
    except Exception:
        return {}

HELP = """usage: splash serve [options]

options:
  --model OWNER/REPO[:VARIANT]
  --revision REVISION   model branch, tag or commit
  --language-only       skip vision
  --offline             start the installed model
  --port PORT           HTTP port
  --host ADDRESS        HTTP bind address
  --allowed-host HOST   additional Host name
  --max-context TOKENS  context limit
  --idle-release DURATION
  --default-reasoning-effort EFFORT
  --no-webui            disable the chat page
"""

def main():
    argv = sys.argv[1:]
    if argv == ["--version"]:
        print("Splash 9.9.9-fake"); return
    if argv[:2] == ["serve", "--help"]:
        print(HELP); return
    assert argv[0] == "serve"
    opts = {}
    i = 1
    while i < len(argv):
        a = argv[i]
        if a in ("--offline", "--language-only", "--disable-ane", "--no-webui"):
            opts[a] = True; i += 1
        else:
            opts[a] = argv[i + 1]; i += 2
    model = opts["--model"]; port = int(opts["--port"]); host = opts.get("--host", "127.0.0.1")
    key = os.environ.get("SPLASH_API_KEY")
    c = control()
    with open(os.path.join(HERE, "starts.log"), "a") as f:
        f.write(json.dumps({"pid": os.getpid(), "argv": argv, "has_key_env": bool(key)}) + "\n")
    print(f"10:00:00 Loading · {model}", flush=True)
    if c.get("fail_start"):
        print("Error · cannot load the model", flush=True); sys.exit(2)
    state = {"active": 0, "draining": False, "ready_at": time.time() + c.get("ready_delay", 0.3)}
    lock = threading.Lock()

    class H(BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.0"
        def log_message(self, *a): pass
        def send(self, code, obj):
            body = json.dumps(obj).encode()
            self.send_response(code); self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body)
        def authed(self):
            if not key: return True
            return self.headers.get("Authorization") == f"Bearer {key}"
        def do_GET(self):
            ready = time.time() >= state["ready_at"]
            if self.path in ("/", "/index.html"):
                if opts.get("--no-webui"): return self.send(404, {"error": {"code": "not_found"}})
                body = b"<!doctype html><title>Splash</title>"
                self.send_response(200); self.send_header("Content-Type", "text/html; charset=utf-8")
                self.send_header("Content-Length", str(len(body))); self.end_headers(); self.wfile.write(body); return
            if self.path == "/health": return self.send(200, {"status": "ok"})
            if self.path == "/ready": return self.send(200 if ready else 503, {"status": "ready" if ready else "loading"})
            if not self.authed(): return self.send(401, {"error": {"code": "authentication_error"}})
            if self.path == "/v1/models":
                data = [{"id": model, "object": "model"}] if ready else []
                return self.send(200, {"object": "list", "data": data})
            if self.path == "/status":
                with lock: active = state["active"]
                http = {"requests": {"active": active, "capacity": 32}}
                if not c.get("no_drain"): http["draining"] = state["draining"]
                return self.send(200, {"ready": ready, "instance": {"pid": os.getpid(), "model": model, "port": port},
                    "http": http,
                    "scheduler": {"queued": 0, "waiting_resources": 0, "waiting_prefix": 0, "prefilling": 0, "decoding": active, "waiting_mask": 0},
                    "admission": {"waiting": 0, "restoring": 0, "suspended": 0}})
            self.send(404, {})
        def do_POST(self):
            if not self.authed(): return self.send(401, {})
            n = int(self.headers.get("Content-Length") or 0); self.rfile.read(n)
            with lock:
                if state["draining"]:
                    return self.send(503, {"error": {"code": "server_draining"}})
                state["active"] += 1
            try:
                time.sleep(control().get("hold", 0))
                self.send(200, {"model": model, "choices": [{"message": {"role": "assistant", "content": "pong"}}]})
            finally:
                with lock: state["active"] -= 1

    class Server(ThreadingHTTPServer):
        def server_bind(self):
            # HTTPServer.server_bind calls socket.getfqdn(), a reverse DNS lookup that can block for
            # many seconds on a CI runner. The fake needs no host name.
            socketserver.TCPServer.server_bind(self)
            self.server_name, self.server_port = host, self.server_address[1]

    server = Server((host, port), H)
    server.daemon_threads = True
    stop = threading.Event()
    drain_requested = threading.Event()
    def term(*_):
        if control().get("ignore_term"): return
        print("Stopping · releasing engine resources", flush=True); stop.set()
    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    if not c.get("no_drain"):
        # Like the real server: the handler only sets an event. Taking `lock` here could deadlock the main thread.
        signal.signal(signal.SIGUSR1, lambda *_: drain_requested.set())
    threading.Thread(target=server.serve_forever, daemon=True).start()
    crash_at = None
    while not stop.is_set():
        time.sleep(0.05)
        with lock:
            if drain_requested.is_set(): state["draining"] = True
            if state["draining"] and state["active"] == 0:
                print("Stopping · releasing engine resources", flush=True); stop.set()
        if crash_at is None and time.time() >= state["ready_at"] and "crash_after" in c:
            limit = c.get("crash_limit")
            starts = sum(1 for _ in open(os.path.join(HERE, "starts.log")))
            if limit is None or starts <= limit:
                crash_at = time.time() + c["crash_after"]
        if crash_at and time.time() >= crash_at:
            print("Error · engine failed", flush=True); os._exit(3)
    server.shutdown(); server.server_close()

main()
